{
  "name": "flequit",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale",
    "dev": "vite dev --host",
    "dev:e2e": "vite dev --port 10000 --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "lint:arch": "eslint src/lib",
    "format": "prettier --write .",
    "check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "npx playwright test",
    "test:prepare:automerge": "mkdir -p .tmp/tests/cargo/flequit-infrastructure-automerge/automerge .tmp/tests/cargo/flequit-infrastructure-automerge/json",
    "test:prepare:db": "cargo run --manifest-path src-tauri/Cargo.toml -p flequit-infrastructure-sqlite --bin migration_runner -- .tmp/tests/test_database.db",
    "test:prepare:db:force": "cargo run --manifest-path src-tauri/Cargo.toml -p flequit-infrastructure-sqlite --bin migration_runner -- .tmp/tests/test_database.db --force",
    "test:prepare": "bun run test:prepare:automerge && bun run test:prepare:db",
    "tauri": "export RUST_LOG=debug && tauri",
    "tauri:dev": "export RUST_LOG=debug && tauri dev --host",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@thisux/sveltednd": "^0.8.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.9",
    "@inlang/paraglide-js": "2.26.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.52.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vaul-svelte": "^0.3.2",
    "vite": "^8.3.3",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11"
  }
}