{
  "name": "flequit",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale",
    "dev": "vite dev --host",
    "dev:e2e": "vite dev --port 10000 --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "lint:arch": "eslint src/lib",
    "format": "prettier --write .",
    "check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "npx playwright test",
    "test:prepare:automerge": "mkdir -p .tmp/tests/cargo/flequit-infrastructure-automerge/automerge .tmp/tests/cargo/flequit-infrastructure-automerge/json",
    "test:prepare:db": "cargo run --manifest-path src-tauri/Cargo.toml -p flequit-infrastructure-sqlite --bin migration_runner -- .tmp/tests/test_database.db",
    "test:prepare:db:force": "cargo run --manifest-path src-tauri/Cargo.toml -p flequit-infrastructure-sqlite --bin migration_runner -- .tmp/tests/test_database.db --force",
    "test:prepare": "bun run test:prepare:automerge && bun run test:prepare:db",
    "tauri": "export RUST_LOG=debug && tauri",
    "tauri:dev": "export RUST_LOG=debug && tauri dev --host",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@thisux/sveltednd": "^0.7.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.3",
    "@inlang/paraglide-js": "2.18.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vaul-svelte": "^0.3.2",
    "vite": "^8.2.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11"
  }
}