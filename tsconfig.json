{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler"
  },
  "include": ["src", "tests"],
  "exclude": ["src/paraglide/**/*", "src/lib/components/ui/**/*"]
  // Path aliases ($lib, $paraglide) are set on the sveltekit() plugin in vite.config.js.
  // `$app/tsconfig` does not declare include/exclude, so they live here.
  // TypeScript does not merge include/exclude from the extended config.
}
